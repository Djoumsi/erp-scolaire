# Configuration environnement - Site vitrine MBOA School
# Copier ce fichier à .env et remplir vos paramètres réels

# ============================================
# 1. EMAIL SERVICE
# ============================================

# Service utilisé : sendgrid ou smtp
EMAIL_SERVICE=sendgrid

# Adresse expéditeur
EMAIL_FROM=contact@techsolutionsddtp.cm

# ============================================
# 2. SENDGRID (Recommandé)
# ============================================

# Obtenir API key : https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 3. SMTP CLASSIQUE (Alternative)
# ============================================

# Gmail, Outlook, ou serveur SMTP personnalisé
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app

# Note pour Gmail :
# 1. Activer "Accès moins sécurisé" ou
# 2. Générer "Mot de passe application" (2FA requis)

# ============================================
# 4. GOOGLE ANALYTICS 4
# ============================================

# ID de mesure GA4 (format: G-XXXXXXXXXX)
# Obtenir : Google Analytics > Admin > Propriété > Streams > Détails du Web
GA4_ID=G-XXXXXXXXXX

# Consentement RGPD
GA4_ANONYMIZE_IP=true
GA4_ALLOW_SIGNALS=false

# ============================================
# 5. SITE
# ============================================

# URL de production
SITE_URL=https://erpscolaire.cm

# Support contact
SUPPORT_EMAIL=support@techsolutionsddtp.cm
SUPPORT_PHONE=+237655454994

# ============================================
# 6. SÉCURITÉ
# ============================================

# Clé secrète pour formulaires (CSRF token)
SECRET_KEY=your_secret_key_here_min_32_chars

# Rate limiting (requêtes par minute)
RATE_LIMIT_REQUESTS=60

# ============================================
# 7. LOGS
# ============================================

# Niveau de log : debug, info, warning, error
LOG_LEVEL=info

# Dossier logs (créé automatiquement)
LOG_DIR=logs/

# ============================================
# INSTRUCTIONS DE CONFIGURATION
# ============================================

# 1. Créer fichier .env à partir de .env.example
# cp .env.example .env

# 2. Choisir email service

# Option A: SENDGRID (Recommandé)
# - Créer compte gratuit : https://sendgrid.com
# - Générer API key
# - Modifier EMAIL_SERVICE=sendgrid
# - Remplir SENDGRID_API_KEY

# Option B: SMTP CLASSIQUE
# - Modifier EMAIL_SERVICE=smtp
# - Remplir SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD
# Pour Gmail :
#   - Activer 2FA
#   - Générer "Mot de passe application"
#   - Utiliser ce mot de passe

# 3. Configurer Google Analytics
# - Créer compte Google Analytics
# - Créer propriété
# - Copier ID mesure (G-xxxxx)
# - Remplir GA4_ID

# 4. Tester la configuration
# - php form-handler.php (test formulaire)
# - php newsletter-handler.php (test newsletter)

# ============================================
# DOCUMENTATION SERVICES
# ============================================

# SendGrid : https://sendgrid.com/docs/
# Gmail SMTP : https://support.google.com/accounts/answer/185833
# Google Analytics 4 : https://support.google.com/analytics/
# RGPD/CNIL : https://www.cnil.fr/
