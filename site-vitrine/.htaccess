# Configuration Apache pour site vitrine ERPScolaire
# Tech Solutions DDTP

# Activer mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS (décommenter en production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forcer www (optionnel)
    # RewriteCond %{HTTP_HOST} ^erpscolaire\.cm$ [NC]
    # RewriteRule ^(.*)$ https://www.erpscolaire.cm/$1 [L,R=301]
</IfModule>

# Sécurité : Bloquer accès directs certains fichiers
<FilesMatch "\.php$">
    # Autoriser index.html et form-handler.php
</FilesMatch>

# Bloquer accès au dossier logs
<Directory "logs">
    <IfModule mod_authz_core.c>
        Deny from all
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Directory>

# Optimisation caching navigateur
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
</IfModule>

# Compression gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
    # Éviter clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Éviter MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Politique de sécurité contenu
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' https: data:;"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Blocage des robots indésirables
<IfModule mod_rewrite.c>
    # Bloquer certains user agents
    # RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider) [NC]
    # RewriteRule ^.* - [F]
</IfModule>
