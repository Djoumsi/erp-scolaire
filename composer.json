{
    "name": "erp/scolaire",
    "description": "ERP de Gestion Scolaire — Primaire, Collège, Lycée, Université",
    "type": "project",
    "require": {
        "php": "^8.0",
        "vlucas/phpdotenv": "^5.6",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
